{
  "name": "meeting-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs && vite build",
    "start": "npm run build && electron .",
    "start:built": "electron .",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:model": "node --import tsx scripts/model-eval.ts",
    "dev": "npm run start",
    "pack:mac": "npm run build && electron-builder --mac --dir",
    "pack:win": "npm run build && electron-builder --win --dir",
    "setup:desktop": "node node_modules/electron/install.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/*.{ts,mjs}\" *.ts package.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/*.{ts,mjs}\" *.ts package.json",
    "test:stream": "node --import tsx scripts/stream-eval.ts"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "dotenv": "17.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.17.7",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "build": {
    "appId": "dev.meetingagent.desktop",
    "productName": "Meeting Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Capture meeting audio only when you explicitly start input.",
        "NSAudioCaptureUsageDescription": "Capture online meeting system audio only when you explicitly start input."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Meeting-Agent-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
