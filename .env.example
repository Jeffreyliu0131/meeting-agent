# Trusted service only. Never prefix these variables with VITE_.
OPENAI_API_KEY=
MEETING_MODEL=gpt-4.1-mini
MEETING_API_BASE=https://api.openai.com/v1
MEETING_STT_MODEL=gpt-live-transcribe
# Separate speech provider. gpt-live-transcribe uses Realtime WebSocket;
# explicitly configured file models (e.g. whisper-1) use /audio/transcriptions.
MEETING_STT_API_BASE=https://api.openai.com/v1
MEETING_STT_API_KEY=
# json_schema (default) or json_object for compatible endpoints
MEETING_RESPONSE_FORMAT=json_schema

# Runtime budgets, not currency prices or latency guarantees.
MEETING_CONTEXT_BYTES=24000
MEETING_MAX_OUTPUT_TOKENS=2500
MEETING_MAX_CALLS_PER_HOUR=2400
MEETING_MAX_TOKENS_PER_HOUR=4000000
MEETING_MIN_BATCH_MS=1500
# Enable only for explicit local development/test input UI.
MEETING_DEV_INPUTS=0
# Optional accelerated real-model fixture cadence (milliseconds).
MEETING_EVAL_INTERVAL_MS=2000
